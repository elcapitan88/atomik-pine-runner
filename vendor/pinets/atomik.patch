+// Regression guard: a user function wrapping request.security and called from
+// SEVERAL places (`f_tf("240")`, `f_tf("D")`) gets one runtime expression name
+// per call site. The secondary-context slice stopped at the FIRST top-level
+// invocation, so later call sites were never evaluated there and the lookup
+// threw "Cannot read properties of undefined (reading '<idx>')".
+describe('request.security inside a function called from several places', () => {
+    it('every call site resolves, matching the direct call', async () => {
+        const pineTS = new PineTS(Provider.Mock, 'BTCUSDC', '60', null, new Date('2024-01-01').getTime(), new Date('2024-01-10').getTime());
+        const code = `
+//@version=5
+indicator("t")
+f_tf(_r) =>
+    request.security(syminfo.tickerid, _r, close)
+a = f_tf("240")
+b = f_tf("D")
+plot(a, "a")
+plot(b, "b")
+plot(request.security(syminfo.tickerid, "240", close), "a_ref")
+plot(request.security(syminfo.tickerid, "D", close), "b_ref")
+`;
+        const { plots } = await pineTS.run(code);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+        expect(vals('a').length).toBeGreaterThan(100);
+        expect(vals('a')).toEqual(vals('a_ref'));
+        expect(vals('b')).toEqual(vals('b_ref'));
+        expect(vals('a')).not.toEqual(vals('b'));
+    });
+});
