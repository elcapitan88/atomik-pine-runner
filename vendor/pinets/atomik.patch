diff --git a/src/utils/intlCache.ts b/src/utils/intlCache.ts
new file mode 100644
index 0000000..b4c9670
--- /dev/null
+++ b/src/utils/intlCache.ts
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * Intl.DateTimeFormat instances are expensive to build (tens of µs to ms) and
+ * immutable once built, yet the time helpers used to construct one on every
+ * call: several per bar for scripts that read hour()/time(tf, session, tz) in
+ * a timezone. One instance per (call site, timezone) is reused instead.
+ * Only successful constructions are cached: an invalid timezone still throws
+ * at the call site, as before.
+ */
+const formatters = new Map<string, Intl.DateTimeFormat>();
+
+export function cachedDateTimeFormat(key: string, make: () => Intl.DateTimeFormat): Intl.DateTimeFormat {
+    let formatter = formatters.get(key);
+    if (formatter === undefined) {
+        formatter = make();
+        formatters.set(key, formatter);
+    }
+    return formatter;
+}
diff --git a/tests/core/atomik-intl-cache.test.ts b/tests/core/atomik-intl-cache.test.ts
new file mode 100644
index 0000000..b6f4a17
--- /dev/null
