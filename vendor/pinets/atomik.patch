+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: `strategy.opentrades` / `strategy.closedtrades` read as a
+// VALUE (a series int, the trade count). The runtime hybrid object (count +
+// per-trade methods) reached plot() as an object: it was taken for the named-
+// args bag, so the plot lost its title and every value was null; `== 0` was
+// always false and str.tostring() did not print the count.
+describe('strategy.opentrades / closedtrades as values', () => {
+    it('plot, ==, str.tostring and arithmetic see the count', async () => {
+        const pineTS = new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-04-01').getTime());
+        const code = `
+//@version=5
+strategy("t")
+if bar_index % 10 == 0
+    strategy.entry("L", strategy.long, qty = 2)
+if bar_index % 10 == 5
+    strategy.close("L")
+plot(strategy.opentrades, "open")
+plot(strategy.closedtrades, "closed")
+plot(strategy.opentrades == 0 ? 1 : 0, "flat")
+plot(strategy.position_size == 0 ? 1 : 0, "flat_ref")
+plot(str.tostring(strategy.closedtrades) == str.tostring(strategy.closedtrades + 0) ? 1 : 0, "str")
+`;
+        const { plots } = await pineTS.run(code);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+        const closed = vals('closed');
+        expect(closed.length).toBeGreaterThan(50);
+        expect(closed.at(-1)).toBeGreaterThan(5);
+        expect(vals('open').every((v: any) => v === 0 || v === 1)).toBe(true);
+        expect(vals('open').some((v: any) => v === 1)).toBe(true);
+        expect(vals('flat')).toEqual(vals('flat_ref'));
+        expect(vals('str').every((v: any) => v === 1)).toBe(true);
+    });
+});
