+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: `strategy.opentrades.size(0)` / `strategy.closedtrades.entry_time(0)`
+// used as a call ARGUMENT (`plot(...)`, `math.abs(...)`), inside a binary operand,
+// or as a function's return value stayed `strategy.opentrades.size(0)` instead of
+// being lowered to the callable sub-namespace `strategy.opentrades().size(0)`,
+// so the script threw "strategy.opentrades.size is not a function".
+describe('strategy.opentrades / closedtrades members in call arguments and returns', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-04-01').getTime());
+
+    it('matches the same expressions read through variables', async () => {
+        const code = `
+//@version=5
+strategy("t")
+if bar_index % 10 == 0
+    strategy.entry("L", strategy.long, qty = 2)
+if bar_index % 10 == 5
+    strategy.close("L")
+lastEntry() =>
+    strategy.closedtrades.entry_time(strategy.closedtrades - 1)
+sz = strategy.opentrades.size(0)
+plot(strategy.opentrades.size(0), "size_arg")
+plot(sz, "size_var")
+plot(math.abs(strategy.opentrades.size(0)) + 0, "abs")
+plot(lastEntry(), "entry_fn")
+plot(strategy.closedtrades > 0 ? strategy.closedtrades.entry_time(strategy.closedtrades - 1) : na, "entry_ref")
+`;
+        const { plots } = await makePineTS().run(code);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+        expect(vals('size_arg').length).toBeGreaterThan(30);
+        expect(vals('size_arg')).toEqual(vals('size_var'));
+        expect(vals('size_var').filter((v: any) => v === 2).length).toBeGreaterThan(5);
+        expect(vals('abs').filter((v: any) => v === 2).length).toBeGreaterThan(5);
+        expect(vals('entry_fn')).toEqual(vals('entry_ref'));
+        expect(vals('entry_fn').some((v: any) => Number.isFinite(v) && v > 1.5e12)).toBe(true);
+    });
+});
