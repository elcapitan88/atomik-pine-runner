+++ b/tests/transpiler/undefined-index-arg.test.ts
@@ -0,0 +1,29 @@
+import { describe, it, expect } from 'vitest';
+import { transpile } from '../../src/transpiler/index';
+
+// Regression guard: every `ns.param(value, undefined, 'pN')` shared ONE AST node
+// for its `undefined` index. A walker that descends into an inline lazy-operand
+// call in a return expression (`cond ? this.hit(x) : false`) rewrote that node
+// in place to `$.get(undefined, 0)`, and the rewrite then appeared in every
+// param call emitted afterwards (`$.get($.get($.get(undefined, 0), 0), 0)`).
+describe('param index stays a plain undefined', () => {
+    it('no $.get(undefined, ...) in the emitted code', () => {
+        const code = `
+//@version=5
+indicator("t")
+type P
+    float v
+method hit(P this, bool hi, float x) =>
+    hi ? x > this.v : x < this.v
+method find(P this, float src, bool hi, bool reg = true) =>
+    float pt = src * 1.0
+    not na(pt) and reg ? this.hit(hi, pt) : false
+var p = P.new(20000)
+plot(p.find(close, true) ? 1 : 0, "a")
+plot(math.max(close, 3), "b")
+`;
+        const js = String(transpile(code));
+        expect(js).toContain(', undefined, ');
+        expect(js).not.toContain('$.get(undefined');
+    });
+});
