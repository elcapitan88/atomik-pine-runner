+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: inside a function body, a `var` declaration or a tuple
+// destructuring followed by more statements on the same line —
+// `var line l = na, line.delete(l)` (LuxAlgo SMC) — failed to parse with
+// "Unexpected token COMMA". Top-level code already accepted it.
+describe('comma-separated statements after a declaration in a function body', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    it('var declaration and tuple destructuring followed by statements', async () => {
+        const code = `
+//@version=5
+indicator("t")
+g(x) =>
+    [x, x * 2]
+f() =>
+    var int c = 0, c += 1
+    [a, b] = g(c), s = a + b
+    s
+drawLevel(float level) =>
+    var line l = na, line.delete(l)
+    l := line.new(bar_index, level, bar_index + 1, level)
+    l
+drawLevel(close)
+plot(f(), "s")
+`;
+        const { plots } = await makePineTS().run(code);
+        const s = plots['s'].data.map((d: any) => d.value);
+        expect(s.length).toBeGreaterThan(10);
+        expect(s.at(-1)).toBe(3 * s.length);
+        const live = plots['__lines__']?.data?.at(-1)?.value?.filter((l: any) => !l._deleted) ?? [];
+        expect(live.length).toBe(1);
+    });
+});
