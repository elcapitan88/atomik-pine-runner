+import { describe, it, expect } from 'vitest';
+import { PineTS } from '../../src/PineTS.class';
+import { Provider } from '@pinets/marketData/Provider.class';
+
+// Regression guard: the built-in VARIABLE `ta.vwap` (`src = ta.vwap`,
+// `plot(ta.vwap)`) means `ta.vwap(hlc3)`. It was lowered to `ta.vwap()` /
+// `ta.vwap('<callId>')` with no source, so every bar was NaN and scripts built
+// on it (VWAP Bollinger bands) plotted nothing.
+describe('bare ta.vwap', () => {
+    it('equals ta.vwap(hlc3) as a variable, a plot argument and an operand', async () => {
+        const pineTS = new PineTS(Provider.Mock, 'BTCUSDC', '60', null, new Date('2024-01-01').getTime(), new Date('2024-01-05').getTime());
+        const code = `
+//@version=5
+indicator("t")
+src = ta.vwap
+plot(src, "var")
+plot(ta.vwap, "arg")
+plot(ta.sma(ta.vwap, 5), "sma")
+plot(ta.vwap(hlc3), "ref")
+plot(ta.sma(ta.vwap(hlc3), 5), "sma_ref")
+`;
+        const { plots } = await pineTS.run(code);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+        expect(vals('ref').length).toBeGreaterThan(50);
+        expect(vals('ref').filter((v: any) => Number.isFinite(v)).length).toBeGreaterThan(50);
+        expect(vals('var')).toEqual(vals('ref'));
+        expect(vals('arg')).toEqual(vals('ref'));
+        expect(vals('sma')).toEqual(vals('sma_ref'));
+    });
+});
diff --git a/tests/namespaces/ta-vwap-trading-day.test.ts b/tests/namespaces/ta-vwap-trading-day.test.ts
new file mode 100644
index 0000000..4657479
--- /dev/null
+++ b/tests/namespaces/ta-vwap-trading-day.test.ts
@@ -0,0 +1,140 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS } from '../../src/PineTS.class';
+
+// Regression guard: `ta.vwap` (bare and `ta.vwap(src)`) resets at a new TRADING
+// day — TradingView's default anchor, `timeframe.change("1D")` — not at the
+// calendar midnight of the exchange timezone. For CME futures (session
+// 1700-1600 America/Chicago) the trading day opens at 17:00 CT, so the reset
+// falls on the 17:00 bar and NOT on the 00:00 bar. `timeframe.change("D")`
+// follows the same boundary, and `ta.vwap(src, anchor, mult)` returns
+// [vwap, upper, lower].
+
+type Bar = { openTime: number; open: number; high: number; low: number; close: number; volume: number; closeTime: number };
+
+function makeProvider(bars: Bar[], session: string, timezone: string) {
+    return {
+        async getMarketData(_t: string, _tf: string, limit?: number, sDate?: number, eDate?: number) {
+            let out = bars;
+            if (sDate) out = out.filter((b) => b.openTime >= sDate);
+            if (eDate) out = out.filter((b) => b.openTime <= eDate);
+            if (limit) out = out.slice(-limit);
+            return out;
+        },
+        async getSymbolInfo() {
+            return { ticker: 'X', tickerid: 'X:X', type: 'futures', mintick: 0.25, pricescale: 100, minmove: 1, pointvalue: 1, currency: 'USD', timezone, session };
+        },
+        configure() {},
+    };
+}
+
+// 30-minute bars over the given UTC windows; deterministic prices/volumes.
+function makeBars(isOpen: (t: number) => boolean, start: number, end: number): Bar[] {
+    let seed = 7;
+    const rnd = () => (seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296;
+    const out: Bar[] = [];
+    let p = 100;
+    for (let t = start; t < end; t += 30 * 60_000) {
+        if (!isOpen(t)) continue;
+        const o = p;
+        const c = o + (rnd() - 0.5) * 4;
+        out.push({ openTime: t, open: o, high: Math.max(o, c) + rnd(), low: Math.min(o, c) - rnd(), close: c, volume: 100 + Math.floor(rnd() * 900), closeTime: t + 30 * 60_000 - 1 });
+        p = c;
+    }
+    return out;
+}
+
+// Reference VWAP over hlc3 that resets on bars where `isReset(t)` is true.
+function referenceVwap(bars: Bar[], isReset: (t: number, i: number) => boolean): number[] {
+    let pv = 0, v = 0;
+    return bars.map((b, i) => {
+        if (i === 0 || isReset(b.openTime, i)) { pv = 0; v = 0; }
+        const src = (b.high + b.low + b.close) / 3;
+        pv += src * b.volume;
+        v += b.volume;
+        return pv / v;
+    });
+}
+
+const CODE = `
+//@version=5
+indicator("t")
+[m, u, l] = ta.vwap(hlc3, timeframe.change("D"), 1)
+plot(ta.vwap, "bare")
+plot(ta.vwap(hlc3), "src")
+plot(m, "m")
+plot(u, "u")
+plot(l, "l")
+plot(timeframe.change("D") ? 1 : 0, "chg")
+`;
+
+const close = (a: number, b: number) => Math.abs(a - b) < 1e-6 * Math.max(1, Math.abs(b));
+
+describe('ta.vwap resets at the trading-day open', () => {
+    it('CME 1700-1600 America/Chicago: resets at 17:00 CT, not at midnight', async () => {
+        // July → CDT (UTC-5): 17:00 CT = 22:00 UTC, 16:00 CT = 21:00 UTC.
+        // Sun 2024-07-07 22:00 UTC (Sun 17:00 CT) → Fri 2024-07-12 21:00 UTC.
+        const start = Date.UTC(2024, 6, 7, 22);
+        const end = Date.UTC(2024, 6, 12, 21);
+        const isOpen = (t: number) => new Date(t).getUTCHours() !== 21; // daily 16:00-17:00 CT halt
+        const bars = makeBars(isOpen, start, end);
+        const pine = new PineTS(makeProvider(bars, '1700-1600', 'America/Chicago') as any, 'X', '30', null, start, end);
+        const { plots } = await pine.run(CODE);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+
+        const expected = referenceVwap(bars, (t) => new Date(t).getUTCHours() === 22 && new Date(t).getUTCMinutes() === 0);
+        const bare = vals('bare');
+        expect(bare.length).toBe(bars.length);
+        bare.forEach((x: number, i: number) => expect(close(x, expected[i])).toBe(true));
+        expect(vals('src')).toEqual(bare);
+
+        // Not a midnight reset: at 00:00 CT (05:00 UTC) the VWAP is not just that bar's hlc3.
+        const midnight = bars.findIndex((b) => new Date(b.openTime).getUTCHours() === 5);
+        const hlc3 = (b: Bar) => (b.high + b.low + b.close) / 3;
+        expect(close(bare[midnight], hlc3(bars[midnight]))).toBe(false);
+
+        // timeframe.change("D") fires exactly on the 17:00 CT bars (after the first bar).
+        const chg = vals('chg');
+        bars.forEach((b, i) => {
+            if (i === 0) return;
+            const at17 = new Date(b.openTime).getUTCHours() === 22 && new Date(b.openTime).getUTCMinutes() === 0;
+            expect(chg[i]).toBe(at17 ? 1 : 0);
+        });
+
+        // Anchored form with bands: same VWAP, symmetric bands, zero width at the reset bar.
+        const m = vals('m'), u = vals('u'), l = vals('l');
+        m.forEach((x: number, i: number) => expect(close(x, expected[i])).toBe(true));
+        u.forEach((x: number, i: number) => {
+            expect(x).toBeGreaterThanOrEqual(m[i] - 1e-9);
+            expect(close(x - m[i], m[i] - l[i])).toBe(true);
+        });
+        const reset = bars.findIndex((b, i) => i > 0 && new Date(b.openTime).getUTCHours() === 22 && new Date(b.openTime).getUTCMinutes() === 0);
+        expect(close(u[reset], m[reset])).toBe(true);
+        expect(u.some((x: number, i: number) => x - m[i] > 0.01)).toBe(true);
+    });
+
+    it('equity 0930-1600 America/New_York: resets at the 09:30 open', async () => {
+        // July → EDT (UTC-4): 09:30 ET = 13:30 UTC, 16:00 ET = 20:00 UTC. Mon-Fri.
+        const start = Date.UTC(2024, 6, 8, 13, 30);
+        const end = Date.UTC(2024, 6, 12, 20);
+        const isOpen = (t: number) => {
+            const d = new Date(t);
+            const m = d.getUTCHours() * 60 + d.getUTCMinutes();
+            return m >= 13 * 60 + 30 && m < 20 * 60;
+        };
+        const bars = makeBars(isOpen, start, end);
+        const pine = new PineTS(makeProvider(bars, '0930-1600', 'America/New_York') as any, 'X', '30', null, start, end);
+        const { plots } = await pine.run(CODE);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+
+        const at0930 = (t: number) => new Date(t).getUTCHours() === 13 && new Date(t).getUTCMinutes() === 30;
+        const expected = referenceVwap(bars, at0930);
+        const bare = vals('bare');
+        expect(bare.length).toBe(bars.length);
+        bare.forEach((x: number, i: number) => expect(close(x, expected[i])).toBe(true));
+        const chg = vals('chg');
+        bars.forEach((b, i) => {
+            if (i > 0) expect(chg[i]).toBe(at0930(b.openTime) ? 1 : 0);
+        });
+        expect(Math.max(...vals('u').map((x: number, i: number) => x - vals('m')[i]))).toBeGreaterThan(0.01);
+    });
+});
