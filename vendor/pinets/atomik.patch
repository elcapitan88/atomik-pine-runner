@@ -0,0 +1,43 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: `[N]` history on a namespace built-in VARIABLE —
+// `strategy.closedtrades[1]`, `strategy.position_size[1]`, `ta.tr[1]` — and on a
+// call result passed as an ARGUMENT (`plot(ta.sma(close, 3)[1])`). The object
+// was auto-called after the subscript was lowered, so `strategy.closedtrades()[1]`
+// read the current value (and `strategy.closedtrades > strategy.closedtrades[1]`
+// never fired); in arguments `plot.param(<scalar>, 1)` gave null.
+describe('history of namespace variables and of call results in arguments', () => {
+    it('matches the same values read through a variable', async () => {
+        const pineTS = new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-04-01').getTime());
+        const code = `
+//@version=5
+strategy("t")
+if bar_index % 10 == 0
+    strategy.entry("L", strategy.long, qty = 1)
+if bar_index % 10 == 5
+    strategy.close("L")
+ct = strategy.closedtrades + 0
+ps = strategy.position_size
+tr = ta.tr
+s = ta.sma(close, 3)
+plot(strategy.closedtrades > strategy.closedtrades[1] ? 1 : 0, "new_close")
+plot(ct > ct[1] ? 1 : 0, "new_close_ref")
+plot(strategy.closedtrades[1], "ct1")
+plot(ct[1], "ct1_ref")
+plot(strategy.position_size[1], "ps1")
+plot(ps[1], "ps1_ref")
+plot(ta.tr[1], "tr1")
+plot(tr[1], "tr1_ref")
+plot(ta.sma(close, 3)[1], "sma1")
+plot(s[1], "sma1_ref")
+`;
+        const { plots } = await pineTS.run(code);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+        expect(vals('new_close').length).toBeGreaterThan(50);
+        expect(vals('new_close').filter((v: any) => v === 1).length).toBeGreaterThan(3);
+        for (const k of ['new_close', 'ct1', 'ps1', 'tr1', 'sma1']) {
+            expect(vals(k), k).toEqual(vals(k + '_ref'));
+        }
+    });
+});
