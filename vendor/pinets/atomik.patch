diff --git a/tests/namespaces/strategy/exit-placed-on-open-position.test.ts b/tests/namespaces/strategy/exit-placed-on-open-position.test.ts
new file mode 100644
index 0000000..0d019fc
--- /dev/null
+++ b/tests/namespaces/strategy/exit-placed-on-open-position.test.ts
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * A strategy.exit placed ONCE on a position that is already open keeps its
+ * stop when that stop sits at or past the entry price.
+ *
+ * The canonical case is "move the runner's stop to breakeven after a partial":
+ *
+ *     if partialFilled and not beDone
+ *         strategy.exit("TP2", "S", limit = target, stop = strategy.position_avg_price)
+ *         beDone := true
+ *
+ * The wrong-sided-leg check in processExitOrders (meant for prices computed
+ * from an OUTGOING position before a reversal) dropped that stop because it is
+ * not strictly beyond the entry, and kept the target: the runner could then
+ * only ever exit at its target, and a strategy that skips setups while in a
+ * trade stopped trading for good. TradingView places the order as given — a
+ * stop already through the market fills at the next open.
+ *
+ * Stale prices are still refused: an exit only counts as placed on a live
+ * position while every trade it covers was open when it was called, so a
+ * reversal or a later trade never inherits it.
+ */
+import { describe, it, expect } from 'vitest';
+import { PineTS } from '../../../src/PineTS.class';
+
+const T0 = Date.UTC(2026, 8, 17, 8, 0);
+const MIN = 60_000;
+
+// Flat at 20000; bar 11 dips to 19990 (short TP1) / bar 11 spikes to 20010
+// (long TP1); from bar 20 price moves `drift` points and stays there.
+function bars(drift: number, { dip = -10 }: { dip?: number } = {}) {
+    const out: any[] = [];
+    for (let i = 0; i < 40; i++) {
+        let o = 20000, h = 20001, l = 19999, c = 20000;
+        if (i === 11) {
+            if (dip < 0) l = 20000 + dip;
+            else h = 20000 + dip;
+        }
+        if (i >= 20) {
+            o = c = 20000 + drift;
+            h = o + 1;
+            l = o - 1;
+        }
+        out.push({ openTime: T0 + i * MIN, closeTime: T0 + i * MIN + MIN - 1, open: o, high: h, low: l, close: c, volume: 100 });
+    }
+    return out;
+}
+
+const HEADER = `//@version=6
+strategy("be", overlay=true, pyramiding=0, initial_capital=10000,
+     default_qty_type=strategy.fixed, default_qty_value=3, margin_long=0, margin_short=0)
+`;
+
+async function run(candles: any[], body: string) {
+    const pineTS = new PineTS(candles, 'MNQ', '1');
+    const ctx: any = await pineTS.run(HEADER + body);
+    return ctx.strategy;
+}
+
+// Short 3 at bar 11's open; 2 come off at 19995; the script then moves the
+// runner's stop to `beStop` once.
+const shortWithBreakeven = (beStop: string) => `
+var bool beDone = false
+if bar_index == 10
+    strategy.entry("S", strategy.short, qty = 3)
+    strategy.exit("S TP1", "S", qty = 2, limit = 19995, stop = 20050)
+    strategy.exit("S TP2", "S", limit = 19950, stop = 20050)
+if strategy.position_size != 0 and math.abs(strategy.position_size) < 3 and not beDone
+    strategy.exit("S TP2", "S", limit = 19950, stop = ${beStop})
+    beDone := true
+`;
+
+describe('strategy.exit placed on an open position', () => {
+    it('a one-off breakeven stop closes a short runner when price comes back', async () => {
+        const st = await run(bars(+10), shortWithBreakeven('strategy.position_avg_price'));
+        expect(st.opentrades.length).toBe(0);
+        const runner = st.closedtrades.find((t: any) => t.exit_id === 'S TP2');
+        expect(runner).toBeDefined();
+        expect(runner.exit_price).toBe(20000); // the next open after the stop was placed
+    });
+
+    it('a one-off profit-locking stop (beyond the entry) is honoured too', async () => {
+        const st = await run(bars(+10), shortWithBreakeven('strategy.position_avg_price - 2'));
+        expect(st.opentrades.length).toBe(0);
+        const runner = st.closedtrades.find((t: any) => t.exit_id === 'S TP2');
+        expect(runner.exit_price).toBe(20000); // already through the stop at the next open
+    });
+
+    it('mirrors for a long runner', async () => {
+        const st = await run(bars(-10, { dip: +10 }), `
+var bool beDone = false
+if bar_index == 10
+    strategy.entry("L", strategy.long, qty = 3)
+    strategy.exit("L TP1", "L", qty = 2, limit = 20005, stop = 19950)
+    strategy.exit("L TP2", "L", limit = 20050, stop = 19950)
+if strategy.position_size > 0 and strategy.position_size < 3 and not beDone
+    strategy.exit("L TP2", "L", limit = 20050, stop = strategy.position_avg_price)
+    beDone := true
+`);
+        expect(st.opentrades.length).toBe(0);
+        expect(st.closedtrades.find((t: any) => t.exit_id === 'L TP2')).toBeDefined();
+    });
+
+    it('without the breakeven move the original stop still governs the runner', async () => {
+        const st = await run(bars(+60), `
+if bar_index == 10
+    strategy.entry("S", strategy.short, qty = 3)
+    strategy.exit("S TP1", "S", qty = 2, limit = 19995, stop = 20050)
+    strategy.exit("S TP2", "S", limit = 19950, stop = 20050)
+`);
+        expect(st.opentrades.length).toBe(0);
+        expect(st.closedtrades.find((t: any) => t.exit_id === 'S TP2').exit_price).toBe(20060);
+    });
+
+    it('a stale stop attached to a reversal entry is still dropped', async () => {
+        // Long open; on bar 15 the script reverses short and prices the new
+        // short's stop off the OUTGOING long's average (wrong side for the
+        // short). TV ignores it; so do we.
+        const st = await run(bars(+10), `
+if bar_index == 5
+    strategy.entry("L", strategy.long, qty = 1)
+if bar_index == 15
+    strategy.entry("S", strategy.short, qty = 1)
+    strategy.exit("XS", "S", stop = strategy.position_avg_price - 5)
+`);
+        expect(st.opentrades.length).toBe(1);
+        expect(st.opentrades[0].entry_id).toBe('S');
+    });
+});
