diff --git a/src/utils/intlCache.ts b/src/utils/intlCache.ts
new file mode 100644
index 0000000..b4c9670
--- /dev/null
+++ b/src/utils/intlCache.ts
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * Intl.DateTimeFormat instances are expensive to build (tens of µs to ms) and
+ * immutable once built, yet the time helpers used to construct one on every
+ * call: several per bar for scripts that read hour()/time(tf, session, tz) in
+ * a timezone. One instance per (call site, timezone) is reused instead.
+ * Only successful constructions are cached: an invalid timezone still throws
+ * at the call site, as before.
+ */
+const formatters = new Map<string, Intl.DateTimeFormat>();
+
+export function cachedDateTimeFormat(key: string, make: () => Intl.DateTimeFormat): Intl.DateTimeFormat {
+    let formatter = formatters.get(key);
+    if (formatter === undefined) {
+        formatter = make();
+        formatters.set(key, formatter);
+    }
+    return formatter;
+}
diff --git a/tests/transpiler/var-init-user-function-once.test.ts b/tests/transpiler/var-init-user-function-once.test.ts
new file mode 100644
index 0000000..40f6fc6
--- /dev/null
+++ b/tests/transpiler/var-init-user-function-once.test.ts
@@ -0,0 +1,100 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+/**
+ * A `var` initializer is evaluated on the first bar only (TradingView). When it
+ * called a user-defined function, PineTS ran the function on every bar and only
+ * discarded the result, so the function's side effects repeated: a table,
+ * label or array element per bar (`var tbl = makeTable()` is how the popular
+ * MLExtensions library's stats table is created).
+ */
+describe('var initializer with a user function call runs once', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', '60', null, new Date('2024-01-01').getTime(), new Date('2024-01-05').getTime());
+    const last = (plots: any, title: string) => plots[title].data[plots[title].data.length - 1].value;
+
+    it('calls the function once and keeps its first result', async () => {
+        const { plots } = await makePineTS().run(`
+//@version=6
+indicator("once")
+var calls = array.new_int(0)
+record() =>
+    array.push(calls, 1)
+    array.size(calls)
+var int first = record()
+var int plusOne = record() + 1
+plot(array.size(calls), "calls")
+plot(first, "first")
+plot(plusOne, "plusOne")
+`);
+        expect(last(plots, 'calls')).toBe(2);
+        expect(last(plots, 'first')).toBe(1);
+        expect(last(plots, 'plusOne')).toBe(3);
+    });
+
+    it('a drawing made inside the function exists once', async () => {
+        const { plots } = await makePineTS().run(`
+//@version=6
+indicator("once", overlay=true, max_labels_count=500)
+makeLabel() =>
+    label.new(bar_index, close, "made")
+makeTable() =>
+    table.new(position.top_right, 2, 2)
+var lb = makeLabel()
+var tbl = makeTable()
+label.set_xy(lb, bar_index, high)
+plot(close)
+`);
+        const labels = plots['__labels__'].data[0].value.filter((l: any) => !l._deleted);
+        expect(labels.length).toBe(1);
+        const tables = plots['__tables__'].data[0].value.filter((t: any) => !t._deleted);
+        expect(tables.length).toBe(1);
+    });
+
+    it('hoisted arguments and factory calls passed to the function are deferred too', async () => {
+        const { plots } = await makePineTS().run(`
+//@version=6
+indicator("once", overlay=true, max_lines_count=500)
+var calls = array.new_int(0)
+record() =>
+    array.push(calls, 1)
+    array.size(calls)
+keep(line ln) =>
+    ln
+var sizes = array.from(record(), 7)
+var line kept = keep(line.new(0, 1, 2, 3))
+plot(array.size(calls), "calls")
+plot(array.get(sizes, 0), "size0")
+plot(line.get_x2(kept), "x2")
+`);
+        expect(last(plots, 'calls')).toBe(1);
+        expect(last(plots, 'size0')).toBe(1);
+        expect(last(plots, 'x2')).toBe(2);
+        const lines = plots['__lines__'].data[0].value.filter((l: any) => !l._deleted);
+        expect(lines.length).toBe(1);
+    });
+
+    it('function-local var state still persists across bars', async () => {
+        const { plots } = await makePineTS().run(`
+//@version=6
+indicator("count")
+counter() =>
+    var int n = 0
+    n += 1
+    n
+start() =>
+    close
+var float s = start()
+plot(counter(), "n")
+plot(s, "s")
+plot(close, "c")
+`);
+        const n = plots['n'].data;
+        expect(n.length).toBeGreaterThan(50);
+        expect(n[n.length - 1].value).toBe(n.length);
+        // `s` keeps the first bar's close on every bar.
+        const first = plots['c'].data[0].value;
+        expect(plots['s'].data.every((d: any) => d.value === first)).toBe(true);
+        expect(plots['c'].data[n.length - 1].value).not.toBe(first);
+    });
+});
