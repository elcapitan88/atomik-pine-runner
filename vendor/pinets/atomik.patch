diff --git a/tests/transpiler/array-element-method-dispatch.test.ts b/tests/transpiler/array-element-method-dispatch.test.ts
new file mode 100644
index 0000000..f16d105
--- /dev/null
+++ b/tests/transpiler/array-element-method-dispatch.test.ts
@@ -0,0 +1,98 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: a user `method` whose name is also a built-in member
+// (`delete`, `get`, `size`, ...) must be dispatched when the receiver is an
+// ELEMENT of an array whose element type is known — the receiver is a call
+// result (`gaps.shift()`, `gaps.get(i)`, `array.pop(gaps)`, `bk.gaps.last()`) or
+// a `for g in gaps` loop variable. These used to fall through to the built-in
+// member and threw `....delete is not a function`.
+describe('user methods on typed array elements', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    const header = `
+//@version=5
+indicator("t")
+type Gap
+    float v
+type Book
+    array<Gap> gaps
+var cnt = 0
+method delete(Gap this) =>
+    cnt += 1
+    this.v
+`;
+
+    it('call-result receivers: shift() / get() / array.pop() on array.new<UDT>()', async () => {
+        const code = header + `
+var gaps = array.new<Gap>()
+gaps.push(Gap.new(close))
+gaps.push(Gap.new(close))
+gaps.push(Gap.new(close))
+gaps.shift().delete()
+gaps.get(0).delete()
+array.pop(gaps).delete()
+plot(cnt, "cnt")
+plot(gaps.size(), "size")
+`;
+        const { plots } = await makePineTS().run(code);
+        const n = plots['cnt'].data.length;
+        expect(n).toBeGreaterThan(10);
+        expect(plots['cnt'].data.at(-1)?.value).toBe(3 * n);
+        expect(plots['size'].data.at(-1)?.value).toBe(n);
+    });
+
+    it('typed annotation, typed param and UDT field arrays', async () => {
+        const code = header + `
+var array<Gap> a = array.new<Gap>()
+var bk = Book.new(array.new<Gap>())
+a.push(Gap.new(close))
+bk.gaps.push(Gap.new(close))
+bk.gaps.push(Gap.new(close))
+f(array<Gap> arr) =>
+    arr.pop().delete()
+a.last().delete()
+bk.gaps.shift().delete()
+f(bk.gaps)
+plot(cnt, "cnt")
+`;
+        const { plots } = await makePineTS().run(code);
+        const n = plots['cnt'].data.length;
+        expect(plots['cnt'].data.at(-1)?.value).toBe(3 * n);
+    });
+
+    it('for-in loop variable over a typed array', async () => {
+        const code = header + `
+var gaps = array.new<Gap>()
+gaps.push(Gap.new(close))
+k = 0
+for g in gaps
+    g.delete()
+    k += 1
+for [i, g] in gaps
+    g.delete()
+plot(cnt, "cnt")
+plot(k, "k")
+`;
+        const { plots } = await makePineTS().run(code);
+        const n = plots['k'].data.length;
+        expect(plots['k'].data.at(-1)?.value).toBe(n);
+        // bar i deletes (i+1) gaps twice: 2 * n(n+1)/2
+        expect(plots['cnt'].data.at(-1)?.value).toBe(n * (n + 1));
+    });
+
+    it('a built-in receiver keeps the built-in member (control)', async () => {
+        const code = header + `
+var lines = array.new_line()
+lines.push(line.new(bar_index, close, bar_index + 1, close))
+if lines.size() > 2
+    lines.shift().delete()
+plot(cnt, "cnt")
+`;
+        const { plots } = await makePineTS().run(code);
+        expect(plots['cnt'].data.at(-1)?.value).toBe(0);
+        const live = plots['__lines__']?.data?.at(-1)?.value?.filter((l: any) => !l._deleted) ?? [];
+        expect(live.length).toBe(2);
+    });
+});
