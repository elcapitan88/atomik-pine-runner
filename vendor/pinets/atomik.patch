+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: Pine keeps functions and variables apart, so scripts name
+// variables after built-in FUNCTIONS — a screener's `indicator = ""` inside a
+// helper, or `barcolor = ...` before `barcolor(barcolor)`. The variable used to
+// hide the built-in from the `$.pine` injection: the top-level `indicator(...)`
+// threw "indicator is not defined" (or read the variable instead).
+describe('variables named like built-in functions', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    it('local `indicator` variable does not hide the indicator() declaration', async () => {
+        const code = `
+//@version=5
+indicator("t", overlay=true)
+calc() =>
+    indicator = ""
+    if close > open
+        indicator := "up"
+    else
+        indicator := "dn"
+    [indicator, close]
+[ind, c] = calc()
+plot(ind == "up" ? 1 : 0, "u")
+plot(close > open ? 1 : 0, "ref")
+`;
+        const { plots } = await makePineTS().run(code);
+        const u = plots['u'].data.map((d: any) => d.value);
+        const ref = plots['ref'].data.map((d: any) => d.value);
+        expect(u.length).toBeGreaterThan(10);
+        expect(u).toEqual(ref);
+    });
+
+    it('`barcolor` and `timestamp` variables next to the built-ins', async () => {
+        const code = `
+//@version=5
+indicator("t", overlay=true)
+barcolor = close > open ? color.green : color.red
+barcolor(barcolor)
+timestamp = timestamp(2019, 1, 1)
+plot(timestamp, "ts")
+`;
+        const { plots } = await makePineTS().run(code);
+        expect(plots['ts'].data.at(-1)?.value).toBe(Date.UTC(2019, 0, 1));
+    });
+});
