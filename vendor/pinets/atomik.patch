+// SPDX-License-Identifier: AGPL-3.0-only
+
+// Atomik: the drawing id counters as one value. A host that rolls a live bar's
+// discarded tick back (exact streaming) restores these with the rest of the
+// state, so a drawing made by the discarded tick doesn't use up an id and the
+// ids match a one-shot run over the same bars.
+import { getBoxIdCounter, setBoxIdCounter } from './box/BoxObject';
+import { getLabelIdCounter, setLabelIdCounter } from './label/LabelObject';
+import { getLineIdCounter, setLineIdCounter } from './line/LineObject';
+import { getLinefillIdCounter, setLinefillIdCounter } from './linefill/LinefillObject';
+import { getPolylineIdCounter, setPolylineIdCounter } from './polyline/PolylineObject';
+import { getTableIdCounter, setTableIdCounter } from './table/TableObject';
+
+export type DrawingIdCounters = { box: number, label: number, line: number, linefill: number, polyline: number, table: number };
+
+export function snapshotDrawingIds(): DrawingIdCounters {
+    return { box: getBoxIdCounter(), label: getLabelIdCounter(), line: getLineIdCounter(), linefill: getLinefillIdCounter(), polyline: getPolylineIdCounter(), table: getTableIdCounter() };
+}
+
+export function restoreDrawingIds(s: DrawingIdCounters): void {
+    setBoxIdCounter(s.box);
+    setLabelIdCounter(s.label);
+    setLineIdCounter(s.line);
+    setLinefillIdCounter(s.linefill);
+    setPolylineIdCounter(s.polyline);
+    setTableIdCounter(s.table);
+}
