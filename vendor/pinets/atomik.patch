@@ -0,0 +1,36 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: a UDT field read with history, `b.i[len]`, passed as a
+// call argument. (1) A variable lookback index leaked bare into the emitted
+// `$.get(b, len)` ("len is not defined"). (2) Before `len` bars of history the
+// read gave `undefined` instead of na, and `plot()` then rejected its whole
+// signature: the title was lost and every value plotted as null.
+describe('UDT field history reads in call arguments', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    it('variable and expression lookbacks, na before enough history', async () => {
+        const code = `
+//@version=5
+indicator("t", overlay=true)
+type bar
+    float h = high
+    int   i = bar_index
+bar b = bar.new()
+len = input.int(3)
+k = 2
+plot(b.i[len], "v")
+plot(math.max(b.i[len], b.i[k * 2]), "w")
+plot(b.i[3], "lit")
+`;
+        const { plots } = await makePineTS().run(code);
+        const v = plots['v'].data.map((d: any) => d.value);
+        expect(v.length).toBeGreaterThan(10);
+        // na (NaN or null once serialized) before 3 bars of history, then bar_index - 3
+        expect(Number.isFinite(v[0])).toBe(false);
+        expect(v.at(-1)).toBe(v.length - 1 - 3);
+        expect(plots['w'].data.at(-1)?.value).toBe(v.length - 1 - 3);
+        expect(plots['lit'].data.map((d: any) => d.value)).toEqual(v);
+    });
+});
