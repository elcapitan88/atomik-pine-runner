+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: a function parameter that has the same name as a global
+// (here the UDT type `kz`, a common Pine idiom: `manage(kz kz)`) must shadow it
+// inside the body. A member chain on the parameter passed to a namespace call
+// (`array.unshift(kz.store, x)`) used to resolve its base to the global type
+// (`$.const.glb1_kz`), so `array.unshift` got `undefined` and threw.
+describe('function parameter shadowing a global of the same name', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    it('namespace call on a field of the shadowing param uses the param', async () => {
+        const code = `
+//@version=5
+indicator("t")
+type kz
+    string title
+    float[] store
+var a = kz.new("x", array.new_float())
+f(kz kz) =>
+    array.unshift(kz.store, close)
+    array.size(kz.store)
+plot(f(a), "n")
+`;
+        const { plots } = await makePineTS().run(code);
+        const n = plots['n'].data;
+        expect(n.length).toBeGreaterThan(10);
+        expect(n.at(-1)?.value).toBe(n.length);
+    });
+
+    it('a shadowing param that is a plain value also resolves to the param', async () => {
+        const code = `
+//@version=5
+indicator("t")
+len = 3
+f(int len) =>
+    math.max(len, 0) + array.size(array.new_float(len))
+plot(f(5), "v")
+`;
+        const { plots } = await makePineTS().run(code);
+        expect(plots['v'].data.at(-1)?.value).toBe(10);
+    });
+});
