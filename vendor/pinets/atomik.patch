@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * `request.currency_rate(from, to)` — no FX feed is available, so a conversion
+ * between two different currencies is `na`; the same currency converts at 1
+ * (the common `request.currency_rate(syminfo.currency, "USD")` on a USD symbol).
+ */
+export function currency_rate(context: any) {
+    return (from: any, to: any, ..._rest: any[]) => {
+        const f = Array.isArray(from) ? from[0] : from;
+        const t = Array.isArray(to) ? to[0] : to;
+        return typeof f === 'string' && typeof t === 'string' && f.toUpperCase() === t.toUpperCase() ? 1 : NaN;
+    };
+}
