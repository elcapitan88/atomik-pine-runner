@@ -0,0 +1,14 @@
+import { describe, it, expect } from 'vitest';
+import { getDatePartsInTimezone } from '../../src/namespaces/Time';
+
+describe('timezone date parts are cached safely', () => {
+    it('returns the same parts on repeat calls, and a copy each time', () => {
+        const t = Date.UTC(2026, 9, 1, 22, 30); // 17:30 America/Chicago (CDT)
+        const a = getDatePartsInTimezone(t, 'America/Chicago');
+        expect(a).toMatchObject({ year: 2026, month: 10, day: 1, hour: 17, minute: 30, dayOfWeek: 4 });
+        a.hour = 99; // a caller mutating its result must not poison the memo
+        const b = getDatePartsInTimezone(t, 'America/Chicago');
+        expect(b.hour).toBe(17);
+        expect(getDatePartsInTimezone(t, 'America/New_York').hour).toBe(18);
+    });
+});
