@@ -0,0 +1,34 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: a two-level field chain on a UDT function parameter inside
+// an operand of a namespace-call argument — `math.floor(this.settings.depth / 2)`
+// (LuxAlgo SMC zigzag) — left the parameter as its Series, so the chain read
+// `undefined.depth` and threw. One-level chains (`s.depth / 2`) already worked.
+describe('nested member chains on function parameters in operands', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    it('method receiver and plain param', async () => {
+        const code = `
+//@version=5
+indicator("t")
+type Settings
+    int depth = 10
+type ZigZag
+    Settings settings
+method upd(series ZigZag this) =>
+    int depth = math.max(2, math.floor(this.settings.depth / 2))
+    depth
+f(ZigZag z) =>
+    math.floor(z.settings.depth / 4) + math.max(z.settings.depth, 1)
+var zz = ZigZag.new(Settings.new())
+plot(zz.upd(), "d")
+plot(f(zz), "e")
+`;
+        const { plots } = await makePineTS().run(code);
+        expect(plots['d'].data.length).toBeGreaterThan(10);
+        expect(plots['d'].data.at(-1)?.value).toBe(5);
+        expect(plots['e'].data.at(-1)?.value).toBe(12);
+    });
+});
