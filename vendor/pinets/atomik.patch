index 0000000..c15802d
--- /dev/null
+++ b/tests/namespaces/request-fundamentals-na.test.ts
@@ -0,0 +1,35 @@
+import { describe, it, expect } from 'vitest';
+import { PineTS } from '../../src/PineTS.class';
+import { Provider } from '@pinets/marketData/Provider.class';
+
+// Regression guard: scripts that merely REFERENCE fundamental requests — the
+// built-in VWAP's "Earnings"/"Dividends"/"Splits" anchors call
+// request.earnings / request.dividends / request.splits on every bar — failed
+// with "request.earnings is not a function". No provider serves such data, so
+// they return na, as TradingView does for symbols without it (futures, crypto).
+describe('request.earnings / dividends / splits / financial / economic / currency_rate', () => {
+    it('return na (currency_rate: 1 for the same currency) and the script runs', async () => {
+        const pineTS = new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+        const code = `
+//@version=5
+indicator("t", overlay=true)
+e = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
+d = request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
+s = request.splits(syminfo.tickerid, splits.denominator, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
+f = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", ignore_invalid_symbol=true)
+g = request.economic("US", "GDP", ignore_invalid_symbol=true)
+anchor = not na(e) or not na(d) or not na(s)
+plot(anchor ? 1 : 0, "anchor")
+plot(na(f) and na(g) ? 1 : 0, "na_fg")
+plot(request.currency_rate("USD", "USD"), "same")
+plot(request.currency_rate("EUR", "USD"), "diff")
+`;
+        const { plots } = await pineTS.run(code);
+        const vals = (k: string) => plots[k].data.map((d: any) => d.value);
+        expect(vals('anchor').length).toBeGreaterThan(10);
+        expect(vals('anchor').every((v: any) => v === 0)).toBe(true);
+        expect(vals('na_fg').every((v: any) => v === 1)).toBe(true);
+        expect(vals('same').every((v: any) => v === 1)).toBe(true);
+        expect(vals('diff').every((v: any) => !Number.isFinite(v))).toBe(true);
+    });
+});
