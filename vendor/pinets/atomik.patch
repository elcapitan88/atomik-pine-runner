+import { describe, it, expect } from 'vitest';
+import { PineTS, Provider } from 'index';
+
+// Regression guard: `for b in boxes` → `b.delete()` where the element is `na`
+// (an `array.new_box(n)` slot, or a drawing created inside a request.security
+// secondary context, where `box.new` returns null). TradingView treats a method
+// call on `na` as a no-op; the emitted `b.delete()` used to throw
+// "Cannot read properties of null (reading 'delete')".
+describe('method calls on na loop elements', () => {
+    const makePineTS = () =>
+        new PineTS(Provider.Mock, 'BTCUSDC', 'D', null, new Date('2019-01-01').getTime(), new Date('2019-03-01').getTime());
+
+    it('b.delete() on na elements is a no-op', async () => {
+        const code = `
+//@version=5
+indicator("t")
+var boxes = array.new_box(3)
+cnt = 0
+for b in boxes
+    b.delete()
+    cnt += 1
+plot(cnt, "cnt")
+`;
+        const { plots } = await makePineTS().run(code);
+        expect(plots['cnt'].data.length).toBeGreaterThan(10);
+        expect(plots['cnt'].data.at(-1)?.value).toBe(3);
+    });
+
+    it('drawings built in a request.security expression can be iterated and deleted', async () => {
+        const code = `
+//@version=5
+indicator("t")
+type Holder
+    array<box> boxes
+method clear(Holder h) =>
+    for b in h.boxes
+        b.delete()
+    h.boxes.size()
+calc() =>
+    var h = Holder.new(array.new_box())
+    h.boxes.push(box.new(bar_index, high, bar_index + 1, low))
+    if h.boxes.size() > 2
+        h.clear()
+        h.boxes.clear()
+    close
+v = request.security(syminfo.tickerid, "W", calc())
+plot(v, "v")
+`;
+        const { plots } = await makePineTS().run(code);
+        expect(plots['v'].data.length).toBeGreaterThan(10);
+        expect(Number.isFinite(plots['v'].data.at(-1)?.value)).toBe(true);
+    });
+});
