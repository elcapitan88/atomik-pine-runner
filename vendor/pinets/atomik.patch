+// SPDX-License-Identifier: AGPL-3.0-only
+
+/**
+ * `request.dividends(...)` — fundamental / corporate-event data is not available
+ * from PineTS data providers, so the call returns `na` on every bar. That is
+ * also what TradingView returns for symbols without such data (futures,
+ * crypto, forex), and it lets scripts that merely reference the function
+ * (e.g. the built-in VWAP's "Earnings"/"Dividends" anchors) run instead of
+ * failing with "request.dividends is not a function".
+ */
+export function dividends(context: any) {
+    return (..._args: any[]) => NaN;
+}
