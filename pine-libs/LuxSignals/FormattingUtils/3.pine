//@version=6

library("FormattingUtils")

// @function Maps a text-size choice from a settings dropdown to a size constant.
// @param choice "Tiny", "Small", "Normal" or "Large". Anything else gives size.normal.
// @returns The matching size.* constant.
export textSizeFromChoice(string choice) =>
    switch choice
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        "Large" => size.large
        => size.normal
